{
  "format": "tps-survey",
  "schema_version": 1,
  "id": "pipeline-test",
  "title": "Pipeline test — Teaching Preferences Survey — Faculty, Spring 2027",
  "term": "2027-spring",
  "version": 1,
  "closes": "2026-12-04",
  "submit_url": "https://teaching-pref-survey.teaching-pref-survey.workers.dev/submit",
  "intro": "This survey is for the **Spring 2027** semester, with an extra question if you want to teach over the **Winter 2027** intersession too.\n\nPlease give as much detail as possible. If we missed anything, you can tell us in the last question. Thanks!",
  "thanks": "Thank you! Your answers help us build the schedule. If anything changes, you can submit again with the same link and we will use your latest answers.",
  "questions": [
    {
      "id": "name",
      "type": "text",
      "text": "What is your name?",
      "required": true
    },
    {
      "id": "email",
      "type": "email",
      "text": "What is your email?",
      "required": true
    },
    {
      "id": "teach_spring",
      "type": "yesno",
      "text": "Do you anticipate teaching during the Spring 2027 semester?",
      "required": true
    },
    {
      "id": "credit_sources",
      "type": "numbers",
      "text": "How many workload credits do you anticipate getting from each of these sources during the Spring 2027 semester?",
      "options": [
        "Teaching at Brooklyn College",
        "Student supervision (e.g., independent research/reading, internship, dissertation)",
        "Course release (e.g., new faculty release time, grants, service)",
        "Other (e.g., teaching at the GC)"
      ],
      "settings": {
        "min": "0",
        "max": "10",
        "step": "0.5",
        "total": "yes",
        "unit": "credits"
      }
    },
    {
      "id": "modality",
      "type": "choice",
      "text": "What is your preferred teaching modality?",
      "help": "We are moving the majority of courses in person, and the college rule still applies: at least 1 course per semester must be in person unless you have an HR waiver. Online courses are expected to have an in-person final exam.",
      "options": [
        "All in-person",
        "A mix of in-person and online",
        "Prefer online as possible"
      ],
      "required": true
    },
    {
      "id": "exam_info",
      "type": "info",
      "text": "Final exams for online courses",
      "help": "All online courses have an in-person final exam.\n\nOnline synchronous final exams are held during the time slot that goes with your bell code (e.g., EW6).\n\nIf you want to teach an online asynchronous course, tell us below when during finals week you are available to hold the exam ([academic calendar](https://www.brooklyn.edu/registrar/academic-calendars/)). Scheduling sets the exact day and time, but we can request your preferred slot. The late afternoon and evening slots are generally easier to book.",
      "show_if": "modality != All in-person"
    },
    {
      "id": "exam_slots",
      "type": "checkboxes",
      "text": "If you teach an online asynchronous course, which finals-week exam slots would work for you?",
      "options": [
        "8:00–10:00 am",
        "10:30 am–12:30 pm",
        "1:00–3:00 pm",
        "3:30–5:30 pm",
        "6:00–8:00 pm",
        "8:30–10:30 pm"
      ],
      "show_if": "modality != All in-person"
    },
    {
      "id": "courses",
      "type": "courses",
      "text": "Which classes do you want to teach?",
      "help": "Pick your classes in order of preference, and add any notes beside each one (e.g., jumbo section, multiple sections, master's class, doctoral class). Add as many as you like.",
      "required": true,
      "show_if": "teach_spring = Yes",
      "settings": {
        "levels": "ug,grad",
        "max": "7",
        "notes": "yes"
      }
    },
    {
      "id": "availability",
      "type": "availability",
      "text": "What days and times are you available to teach? Any preferred?",
      "help": "Click or drag across the blocks when you can teach. Switch to **Preferred** to mark the times you like best. Classes are scheduled in the college's standard [bell code](https://employees.brooklyn.edu/base/fall-and-spring-bell-codes/) slots, so longer classes need several blocks in a row.",
      "required": true,
      "show_if": "teach_spring = Yes",
      "settings": {
        "days": "M,T,W,Th,F,Sa,Su",
        "notes": "yes"
      }
    },
    {
      "id": "teach_winter",
      "type": "yesno",
      "text": "Do you want to teach during the Winter 2027 intersession?",
      "help": "Winter teaching counts toward your annual workload.",
      "required": true
    },
    {
      "id": "winter_courses",
      "type": "courses",
      "text": "For the Winter intersession, which class(es) do you want to teach?",
      "show_if": "teach_winter = Yes",
      "settings": {
        "levels": "ug,grad",
        "max": "3",
        "notes": "yes"
      }
    },
    {
      "id": "winter_details",
      "type": "longtext",
      "text": "For the Winter intersession, what days, times and format would you like? If online, when would you like to hold the in-person final exam?",
      "show_if": "teach_winter = Yes"
    },
    {
      "id": "anything_else",
      "type": "longtext",
      "text": "Is there anything else you would like us to know?"
    }
  ],
